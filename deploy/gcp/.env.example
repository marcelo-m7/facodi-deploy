# Copy to .env, set real values, and chmod 600. Use a separate test hostname.
FACODI_GCP_DOMAIN=gcp.example.org
GCP_DB_PASSWORD=replace-with-a-long-random-value
GCP_ODOO_ADMIN_PASSWORD=replace-with-a-different-long-random-value

# A matching HTTPS URL and secret key must be set together to enable Supabase analysis.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWKS_URL=
GEMINI_API_KEY=
OPENAI_API_KEY=
ODOO_WORKERS=2
ODOO_MAX_CRON_THREADS=1
FACODI_ALLOW_SINGLE_WEBSITE_BOOTSTRAP=0
